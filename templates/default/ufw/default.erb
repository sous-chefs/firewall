IPV6=<%= @defaults[:ipv6] %>
MANAGE_BUILTINS=<%= @defaults[:manage_builtins] %>

<% @defaults[:policy].each do |policy, value| -%>
<%= "DEFAULT_#{policy.upcase}_POLICY=\"#{value}\"" %>
<% end -%>

IPT_SYSCTL="<%= @defaults[:ipt_sysctl] %>"

IPT_MODULES="<%= @defaults[:ipt_modules] %>"
